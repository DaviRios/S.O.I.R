{
  "name": "soir",
  "version": "0.0.0",
  "author": "Davi Rios",
  "license": "MIT",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node tools/dev.mjs",
    "dev:back": "nx serve back --outputStyle=stream-without-prefixes",
    "dev:front": "nx serve front --outputStyle=stream-without-prefixes",
    "build": "nx run-many -t build --all",
    "test": "nx run-many -t test --all --runInBand",
    "typecheck": "tsc -p apps/back/tsconfig.app.json --noEmit && tsc -p apps/front/tsconfig.app.json --noEmit && tsc -p apps/back/tsconfig.spec.json --noEmit && tsc -p apps/front/tsconfig.spec.json --noEmit && tsc -p tools/tsconfig.json --noEmit",
    "lint": "nx run-many -t lint --all",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:import-legacy": "ts-node --project tools/tsconfig.json tools/import-legacy-cms.ts",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/react": "^23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "babel-jest": "~30.3.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jiti": "2.4.2",
    "nx": "23.1.1",
    "pino-pretty": "^13.2.0",
    "prettier": "~3.6.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.3",
    "@fastify/multipart": "^10.1.2",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-zod": "^1.0.0",
    "@fontsource/poppins": "^5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "^5.104.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "argon2": "^0.45.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "6.30.3",
    "zod": "^4.6.5"
  }
}
